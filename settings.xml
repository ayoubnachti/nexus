<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">

    <!-- All Maven downloads go through Nexus -->
    <mirrors>
        <mirror>
            <id>nexus-public</id>
            <mirrorOf>*</mirrorOf>
            <url>${env.NEXUS_URL}/repository/maven-public/</url>
        </mirror>
    </mirrors>

    <!-- Credentials for downloading and publishing artifacts -->
    <servers>
        <server>
            <id>nexus-public</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>

        <server>
            <id>nexus-releases</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>

        <server>
            <id>nexus-snapshots</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>

</settings>
